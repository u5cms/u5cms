    {
      "id": "F1",
      "problem": "Fixed inline F-object frame height excluded captions; fixed image height could distort the authored ratio when width shrank.",
      "reproduction": "Real seeded CMS: 800x400 F-object frame ended 29px before its caption bottom at 1440px.",
      "correction": "Responsive-only image/frame geometry; configured ratio preserved, height-only raster objects use native dimensions, captions stay in flow. Legacy output unchanged."
    },
    {
      "id": "F2",
      "problem": "Template recognition could match body examples in attributes/raw text/inert templates or body-prefixed custom elements; HTML entities were not decoded. Large unquoted attributes exhausted the JIT stack.",
      "reproduction": "body-example falsely enabled responsive mode; a valid 200000-byte unquoted attribute returned false with PCRE error 6.",
      "correction": "Consume complete tags with disjoint possessive tokens; respect raw-text and template context, exact body names, attribute ownership and decoded values."
    },
    {
      "id": "F3",
      "problem": "A malformed authored URL threw from the global navigation click handler.",
      "reproduction": "href=http://[ caused a TypeError during a prevented click.",
      "correction": "Contain URL parsing failure; leave unrelated link handling alone."
    }
  ],
